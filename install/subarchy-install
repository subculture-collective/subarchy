#!/usr/bin/env bash
# Subarchy installer, scripted stage (ADR 0049). Runs on the live ISO.
#
# Usage: subarchy-install --config FILE --yes
#
# Wipes the disk named in the config and installs Subarchy to it:
# GPT with a 4 GiB EFI partition and a LUKS2 root (ADR 0009, 0010), btrfs
# subvolumes @ @home @log @pkg, linux-zen and linux-lts as unified kernel
# images built by mkinitcpio's systemd hooks (ADR 0004, 0008), Limine
# (ADR 0007) with snapshot entries, snapper for @ (ADR 0011), zram swap (ADR 0014) and
# NetworkManager (ADR 0016). The TUI that asks the questions comes later and
# writes this config file.
#
# Config: KEY=value lines, '#' comments. Keys:
#   DISK                  whole disk to wipe, e.g. /dev/vda (required)
#   HOSTNAME              (required)
#   USERNAME              (required)
#   USER_PASSWORD_FILE    file holding the user's password (required)
#   LUKS_PASSPHRASE_FILE  file holding the disk passphrase (required)
#   TIMEZONE              e.g. America/Chicago (default UTC)
#   LOCALE                e.g. en_US.UTF-8 (default)
#   KEYMAP                console keymap (default us)
#   XKB_LAYOUT            desktop keyboard layout (default us)
#   SUBARCHY_REPO         pacman Server URL for the [subarchy] repository (required)
#   PACKAGE_CACHE         pacman cache directory to reuse (optional)
#   OFFLINE               1 to skip the mirrors and install from SUBARCHY_REPO alone (optional)
#   KERNEL_CMDLINE_EXTRA  appended to the kernel command line (optional)
set -euo pipefail

here=$(dirname "$(realpath "$0")")
target=/mnt
log=/var/log/subarchy-install.log

die() { echo "subarchy-install: $*" >&2; exit 1; }
step() { echo ">> $*"; }

declare -A conf=(
  [TIMEZONE]=UTC [LOCALE]=en_US.UTF-8 [KEYMAP]=us [XKB_LAYOUT]=us
  [PACKAGE_CACHE]="" [KERNEL_CMDLINE_EXTRA]="" [OFFLINE]=""
)
keys=" DISK HOSTNAME USERNAME USER_PASSWORD_FILE LUKS_PASSPHRASE_FILE TIMEZONE LOCALE KEYMAP XKB_LAYOUT SUBARCHY_REPO PACKAGE_CACHE KERNEL_CMDLINE_EXTRA OFFLINE "

read_config() {
  local line key value n=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "$1:$n: expected KEY=value"
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    [[ $keys == *" $key "* ]] || die "$1:$n: unknown key $key"
    conf[$key]=$value
  done <"$1"
  for key in DISK HOSTNAME USERNAME USER_PASSWORD_FILE LUKS_PASSPHRASE_FILE SUBARCHY_REPO; do
    [[ -n ${conf[$key]:-} ]] || die "$1: $key is required"
  done
  [[ ${conf[HOSTNAME]} =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "HOSTNAME: lowercase letters, digits and dashes"
  [[ ${conf[USERNAME]} =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "USERNAME: not a valid user name"
  [[ -f /usr/share/zoneinfo/${conf[TIMEZONE]} ]] || die "TIMEZONE: unknown zone ${conf[TIMEZONE]}"
  [[ -s ${conf[USER_PASSWORD_FILE]} ]] || die "USER_PASSWORD_FILE: missing or empty"
  [[ -s ${conf[LUKS_PASSPHRASE_FILE]} ]] || die "LUKS_PASSPHRASE_FILE: missing or empty"
}

check_disk() {
  local disk=${conf[DISK]}
  [[ -b $disk ]] || die "DISK $disk is not a block device"
  [[ $(lsblk -dno TYPE "$disk") == disk ]] || die "DISK $disk is not a whole disk"
  if lsblk -no MOUNTPOINTS "$disk" | grep -q .; then
    die "DISK $disk has mounted partitions"
  fi
  if [[ -e /run/archiso/bootmnt ]] && [[ $(findmnt -no SOURCE /run/archiso/bootmnt) == "$disk"* ]]; then
    die "DISK $disk is the install medium"
  fi
}

# partition DISK: 4 GiB ESP and the rest for LUKS (ADR 0009).
partition() {
  local disk=${conf[DISK]}
  step "partitioning $disk"
  wipefs --all --quiet "$disk"
  sgdisk --zap-all --clear \
    --new=1:0:+4G --typecode=1:ef00 --change-name=1:EFI \
    --new=2:0:0 --typecode=2:8309 --change-name=2:subarchy \
    "$disk" >/dev/null
  udevadm settle
  esp=$(lsblk -lnpo NAME "$disk" | sed -n 2p)
  luks=$(lsblk -lnpo NAME "$disk" | sed -n 3p)
  [[ -b $esp && -b $luks ]] || die "partitions did not appear"
}

encrypt() {
  step "encrypting $luks (LUKS2)"
  local key=${conf[LUKS_PASSPHRASE_FILE]}
  # The passphrase file must not carry the trailing newline a user would not type.
  cryptsetup luksFormat --type luks2 --batch-mode --label subarchy-luks \
    --key-file <(printf '%s' "$(<"$key")") "$luks"
  cryptsetup open --key-file <(printf '%s' "$(<"$key")") "$luks" root
  luks_uuid=$(cryptsetup luksUUID "$luks")
}

make_filesystems() {
  step "creating btrfs subvolumes"
  mkfs.fat -F 32 -n EFI "$esp" >/dev/null
  mkfs.btrfs --quiet --label subarchy /dev/mapper/root
  mount /dev/mapper/root "$target"
  local sv
  for sv in @ @home @log @pkg; do
    btrfs subvolume create "$target/$sv" >/dev/null
  done
  umount "$target"
  local opts=compress=zstd:3,noatime
  mount -o "$opts,subvol=@" /dev/mapper/root "$target"
  mkdir -p "$target"/{boot,home,var/log,var/cache/pacman/pkg}
  mount -o "$opts,subvol=@home" /dev/mapper/root "$target/home"
  mount -o "$opts,subvol=@log" /dev/mapper/root "$target/var/log"
  mount -o "$opts,subvol=@pkg" /dev/mapper/root "$target/var/cache/pacman/pkg"
  mount -o umask=0077 "$esp" "$target/boot"
}

# Files mkinitcpio reads must exist before the kernels are installed, so the
# first build already produces the UKIs.
write_boot_config() {
  step "writing boot configuration"
  local cmdline="rd.luks.name=$luks_uuid=root rd.luks.options=discard root=/dev/mapper/root rootflags=subvol=@ rw"
  # AppArmor (ADR 0063) and the Plymouth splash (ADR 0013).
  cmdline+=" lsm=landlock,lockdown,yama,integrity,apparmor,bpf quiet splash"
  [[ -n ${conf[KERNEL_CMDLINE_EXTRA]} ]] && cmdline+=" ${conf[KERNEL_CMDLINE_EXTRA]}"
  install -d "$target"/etc/{kernel,mkinitcpio.conf.d,default,plymouth}
  echo "$cmdline" >"$target/etc/kernel/cmdline"
  # The Subarchy splash (ADR 0013), chosen before pacstrap so the UKIs it
  # builds carry the theme; pacman leaves this file and writes its own as
  # plymouthd.conf.pacnew.
  printf '[Daemon]\nTheme=subarchy\n' >"$target/etc/plymouth/plymouthd.conf"
  # Hardware fixes (ADR 0050): modprobe options, initramfs modules and
  # kernel command line drop-ins for this machine, written now so the UKIs
  # pacstrap builds carry them.
  if command -v subcult-hw >/dev/null; then
    subcult-hw apply --target "$target" >"$target/var/log/subarchy-hw-apply.log" ||
      die "hardware fixes could not be written (see $target/var/log/subarchy-hw-apply.log)"
    grep -v '^initramfs:' "$target/var/log/subarchy-hw-apply.log" || true
  fi
  printf "KEYMAP=%s\nXKBLAYOUT=%s\n" "${conf[KEYMAP]}" "${conf[XKB_LAYOUT]}" >"$target/etc/vconsole.conf"
  cat >"$target/etc/mkinitcpio.conf.d/subarchy.conf" <<'EOF'
# Subarchy (ADR 0008): systemd-based initramfs; sd-btrfs-overlayfs makes
# read-only snapshots bootable (ADR 0011); plymouth draws the splash and the
# LUKS prompt (ADR 0013).
HOOKS=(base systemd plymouth autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt filesystems fsck sd-btrfs-overlayfs)
EOF
  # limine-mkinitcpio-hook builds one UKI per kernel and writes the Limine
  # entries; limine-snapper-sync adds the snapshot entries (ADR 0007, 0011).
  cat >"$target/etc/default/limine" <<EOF
# Subarchy boot entries (ADR 0007, 0008, 0011). Read by limine-entry-tool
# and limine-snapper-sync; see /etc/limine-entry-tool.conf for all options.
TARGET_OS_NAME="Subarchy"
ESP_PATH="/boot"
KERNEL_CMDLINE[default]="$cmdline"
ENABLE_UKI=yes
CUSTOM_UKI_NAME="subarchy"
ENABLE_LIMINE_FALLBACK=yes
FIND_BOOTLOADERS=no
BOOT_ORDER="linux-zen, linux-lts, *, *fallback, Snapshots"
MAX_SNAPSHOT_ENTRIES=5
# Where @ and snapper's snapshots sit on the volume: limine-snapper-sync
# detects them when it makes a snapshot but needs them stated to restore one.
ROOT_SUBVOLUME_PATH="/@"
ROOT_SNAPSHOTS_PATH="/@/.snapshots"
EOF
  # Global menu options; the tools add the entries below them. Entry 1 is
  # the Subarchy directory, so entry 2 is its first kernel (linux-zen).
  cat >"$target/boot/limine.conf" <<'EOF'
timeout: 3
default_entry: 2
serial: yes
interface_branding: SUBCULT // Subarchy
interface_branding_colour: 8b5cf6
EOF
}

# The Arch mirrors answer, or the install runs from the image's repository
# alone (ADR 0049). OFFLINE=1 in the config skips the probe.
mirrors_reachable() {
  [[ ${conf[OFFLINE]} == 1 ]] && return 1
  curl -sfI --max-time 8 -o /dev/null "https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db"
}

pacstrap_packages() {
  step "installing packages"
  local conf_file=/tmp/subarchy-pacman.conf online=1
  mirrors_reachable || { online=0; echo "no mirror reachable: installing from the image's repository alone"; }
  {
    sed '/^\[core\]/,$d' /etc/pacman.conf
    if [[ -n ${conf[PACKAGE_CACHE]} ]]; then
      echo "CacheDir = ${conf[PACKAGE_CACHE]}"
    fi
    # The repository on the image doubles as a cache: online, a package of
    # the same version is read from it instead of fetched.
    if [[ ${conf[SUBARCHY_REPO]} == file://* ]]; then
      echo "CacheDir = ${conf[SUBARCHY_REPO]#file://}"
    fi
    # Online the mirrors come first, so a newer package wins over the
    # image's copy; the repository supplies Subarchy's own packages and,
    # offline, everything.
    ((online)) && printf '[core]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra]\nInclude = /etc/pacman.d/mirrorlist\n\n'
    printf '[subarchy]\nSigLevel = Optional TrustAll\nServer = %s\n' "${conf[SUBARCHY_REPO]}"
  } >"$conf_file"
  local -a pkgs
  mapfile -t pkgs < <(sed 's/#.*//; /^[[:space:]]*$/d' "$here/packages/base.txt" "$here/packages/desktop.txt")
  # Microcode, firmware and GPU drivers for this machine (ADR 0005, 0006).
  local -a hw
  if command -v subcult-hw >/dev/null; then
    mapfile -t hw < <(subcult-hw packages)
  else
    echo "subarchy-install: subcult-hw not found; installing all firmware and microcode" >&2
    hw=(linux-firmware intel-ucode amd-ucode)
  fi
  echo "hardware packages: ${hw[*]}"
  pkgs+=("${hw[@]}")
  local -a cache=()
  [[ -n ${conf[PACKAGE_CACHE]} ]] && cache=(-c)
  pacstrap -C "$conf_file" -K "${cache[@]}" "$target" "${pkgs[@]}"
}

configure_system() {
  step "configuring the system"
  genfstab -U "$target" >>"$target/etc/fstab"
  echo "${conf[HOSTNAME]}" >"$target/etc/hostname"
  ln -sf "/usr/share/zoneinfo/${conf[TIMEZONE]}" "$target/etc/localtime"
  sed -i "s/^#\(${conf[LOCALE]//./\\.} \)/\1/" "$target/etc/locale.gen"
  echo "LANG=${conf[LOCALE]}" >"$target/etc/locale.conf"
  # The wireless regulatory domain from the time zone's country (ADR 0050,
  # Omarchy's set-wireless-regdom as behaviour): zone.tab maps the zone to
  # its ISO country.
  local country
  country=$(awk -v tz="${conf[TIMEZONE]}" '$1 !~ /^#/ && $3 == tz { print $1; exit }' /usr/share/zoneinfo/zone.tab 2>/dev/null || true)
  if [[ $country =~ ^[A-Z]{2}$ ]]; then
    install -d "$target/etc/conf.d"
    printf 'WIRELESS_REGDOM="%s"\n' "$country" >>"$target/etc/conf.d/wireless-regdom"
  fi
  arch-chroot "$target" locale-gen >/dev/null
  arch-chroot "$target" hwclock --systohc 2>/dev/null || true

  cat >"$target/etc/systemd/zram-generator.conf" <<'EOF'
# Subarchy (ADR 0014): compressed swap in RAM.
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
EOF

  # Trust the Subarchy repository's key (ADR 0025); pacstrap -K initialised
  # the keyring before the keyring package's install script could.
  arch-chroot "$target" pacman-key --populate subarchy >/dev/null
  arch-chroot "$target" systemctl enable --quiet NetworkManager systemd-timesyncd sddm \
    systemd-resolved ufw apparmor avahi-daemon bluetooth power-profiles-daemon subcult-power-auto
  # New installs follow the stable channel (ADR 0026): Arch packages from the
  # Arch Linux Archive at the snapshot date the package ships.
  arch-chroot "$target" subcult-channel set stable --quiet
  # thermald comes with Intel CPUs from hardware detection (ADR 0021).
  if [[ -e $target/usr/lib/systemd/system/thermald.service ]]; then
    arch-chroot "$target" systemctl enable --quiet thermald
  fi
  # Services the detected hardware needs (ADR 0050): displaylink for a
  # DisplayLink adapter.
  if command -v subcult-hw >/dev/null; then
    local svc
    while read -r svc; do
      # A unit the package ships, or one a hardware fix wrote under /etc.
      [[ -n $svc && (-e $target/usr/lib/systemd/system/$svc.service || -e $target/etc/systemd/system/$svc.service) ]] || continue
      arch-chroot "$target" systemctl enable --quiet "$svc"
    done < <(subcult-hw services)
  fi
  # DNS through resolved's stub (ADR 0020); .local through Avahi.
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$target/etc/resolv.conf"
  sed -i 's/^hosts: mymachines resolve/hosts: mymachines mdns_minimal [NOTFOUND=return] resolve/' \
    "$target/etc/nsswitch.conf"
  # ufw: deny incoming, allow outgoing (its defaults), on at boot (ADR 0019).
  sed -i 's/^ENABLED=no/ENABLED=yes/' "$target/etc/ufw/ufw.conf"

  local user=${conf[USERNAME]}
  arch-chroot "$target" useradd --create-home --groups wheel,realtime --shell /usr/bin/zsh "$user"
  printf '%s:%s\n' "$user" "$(<"${conf[USER_PASSWORD_FILE]}")" | arch-chroot "$target" chpasswd
  arch-chroot "$target" passwd --lock root >/dev/null
  install -m 0440 /dev/stdin "$target/etc/sudoers.d/10-wheel" <<<'%wheel ALL=(ALL:ALL) ALL'
  # zsh's first-run wizard would greet the user otherwise.
  touch "$target/home/$user/.zshrc"
  arch-chroot "$target" chown "$user:$user" "/home/$user/.zshrc"
  # A new user starts current: migrations shipped so far are already done.
  arch-chroot "$target" runuser -u "$user" -- subcult-update migrate --mark-all
  # The default theme, through Pult (ADR 0037): the user's own copy of
  # each themed app config, which `pult uninstall` undoes.
  arch-chroot "$target" runuser -u "$user" -- env HOME="/home/$user" \
    pult apply -yes -profile /usr/share/subcult/default/theme/subarchy.toml ||
    echo "subarchy-install: pult apply failed; run it after login" >&2
  # The user's Hyprland config: Subarchy's defaults plus room for overrides
  # (ADR 0048). Written once; updates never touch it.
  arch-chroot "$target" runuser -u "$user" -- install -Dm644 \
    /usr/share/subcult/default/hypr/user-hyprland.lua "/home/$user/.config/hypr/hyprland.lua"
  echo kitty.desktop >"$target/home/$user/.config/xdg-terminals.list"
  arch-chroot "$target" chown "$user:$user" "/home/$user/.config/xdg-terminals.list"
}

setup_snapper() {
  step "configuring snapper"
  arch-chroot "$target" snapper --no-dbus -c root create-config /
  arch-chroot "$target" snapper --no-dbus -c root set-config \
    NUMBER_LIMIT=5 NUMBER_LIMIT_IMPORTANT=5 TIMELINE_CREATE=no
}

install_limine() {
  step "checking the boot entries"
  # The pacman hooks already built the UKIs and the menu while pacstrapping;
  # run them once more now that snapper is set up, then sync snapshots.
  arch-chroot "$target" limine-update
  arch-chroot "$target" systemctl enable --quiet limine-snapper-sync.service
  local kernel
  for kernel in linux-zen linux-lts; do
    [[ -s $target/boot/EFI/Linux/subarchy_$kernel.efi ]] || die "$kernel UKI missing"
  done
  [[ -s $target/boot/EFI/BOOT/BOOTX64.EFI ]] || die "Limine fallback loader missing"
  grep -q '^/+Subarchy' "$target/boot/limine.conf" || die "no Subarchy entry in limine.conf"
}

finish() {
  step "finishing"
  cp "$log" "$target/var/log/subarchy-install.log" 2>/dev/null || true
  sync
  umount -R "$target"
  # Read-only snapshot of the fresh install for factory reset, outside
  # snapper's rotation (ADR 0049, 0056).
  local top=/run/subarchy-top
  mkdir -p "$top"
  mount -o subvolid=5 /dev/mapper/root "$top"
  btrfs subvolume snapshot -r "$top/@" "$top/@factory" >/dev/null
  umount "$top"
  cryptsetup close root
}

main() {
  local config="" yes=0
  local -a args=("$@")
  while (($#)); do
    case $1 in
      --config) config=${2:?--config needs a file}; shift 2 ;;
      --yes) yes=1; shift ;;
      -h | --help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      *) die "unknown argument $1" ;;
    esac
  done
  [[ -n $config ]] || die "--config FILE is required"
  ((EUID == 0)) || die "run as root"
  [[ -d /run/archiso ]] || die "run this from the Subarchy live ISO"
  # arch-chroot binds /run privately. On a shared live mount tree, copies
  # can remain in service namespaces after our unmount and keep LUKS busy.
  # Isolate the whole install before creating any mounts.
  if [[ ${SUBARCHY_INSTALL_PRIVATE_MOUNTS:-} != 1 ]]; then
    exec unshare --mount --propagation private env SUBARCHY_INSTALL_PRIVATE_MOUNTS=1 "$0" "${args[@]}"
  fi
  read_config "$config"
  check_disk
  ((yes)) || die "this wipes ${conf[DISK]}; pass --yes to continue"

  exec > >(tee -a "$log") 2>&1
  partition
  encrypt
  make_filesystems
  write_boot_config
  pacstrap_packages
  configure_system
  setup_snapper
  install_limine
  finish
  echo "subarchy-install: done"
}

main "$@"
