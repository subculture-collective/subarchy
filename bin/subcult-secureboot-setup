#!/usr/bin/env bash
# subcult:summary=Turn on Secure Boot with this machine's own keys
# subcult:requires-sudo=true
# subcult:dangerous=true
# subcult:examples=sudo subcult secureboot setup
#
# ADR 0012. With the firmware in setup mode: create keys with sbctl, sign
# Limine and the UKIs, enroll Limine's config hash, check that every boot
# file is signed, and only then enroll the keys next to Microsoft's (GPU and
# network option ROMs need those). Kernel and bootloader updates are then
# signed by the sbctl and limine-entry-tool hooks.
#
# The keys go in last: once they are enrolled, firmware may enforce Secure
# Boot at the next start, and an unsigned boot loader would be refused. A
# run that stopped half way is finished by running the command again.
#
# Not done: kernel lockdown (ADR 0063). Lockdown refuses unsigned kernel
# modules, which would stop DKMS drivers such as NVIDIA's from loading until
# module signing exists.
set -euo pipefail

say() { echo ">> $*"; }
die() { echo "subcult secureboot: $*" >&2; exit 1; }

# SUBCULT_TEST_ROOT: a stand-in filesystem root for tools/test/secureboot-test.sh.
root=${SUBCULT_TEST_ROOT:-}
limine_default=$root/etc/default/limine
[[ -n $root ]] || ((EUID == 0)) || die "run with sudo"
[[ -d $root/sys/firmware/efi ]] || die "this machine did not boot with UEFI"
command -v sbctl >/dev/null || die "sbctl is not installed (sudo pacman -S sbctl)"

status=$(sbctl status --json)
have_keys=0 setup_mode=0
[[ $status == *'"installed": true'* || $status == *'"installed":true'* ]] && have_keys=1
[[ $status == *'"setup_mode": true'* || $status == *'"setup_mode":true'* ]] && setup_mode=1
if ((!have_keys && !setup_mode)); then
  cat >&2 <<'EOF'
subcult secureboot: the firmware is not in setup mode.
  Reboot into the firmware settings (often F2 or Del), find Secure Boot, and
  choose "Reset to setup mode" or "Clear keys". Leave Secure Boot itself off,
  boot Subarchy and run this command again.
EOF
  exit 1
fi

if ((have_keys)); then
  say "keys exist from an earlier run; finishing the setup"
else
  say "creating keys"
  sbctl create-keys
fi

say "turning on Limine config enrollment"
if grep -q '^ENABLE_ENROLL_LIMINE_CONFIG=' "$limine_default"; then
  sed -i 's/^ENABLE_ENROLL_LIMINE_CONFIG=.*/ENABLE_ENROLL_LIMINE_CONFIG=yes/' "$limine_default"
else
  echo 'ENABLE_ENROLL_LIMINE_CONFIG=yes' >>"$limine_default"
fi

say "signing Limine and the kernels"
limine-update
# limine-update copies the fallback loader unsigned; keep it in sbctl's
# list so its pacman hook re-signs it after every update.
if [[ -f $root/boot/EFI/BOOT/BOOTX64.EFI ]]; then
  sbctl sign --save "$root/boot/EFI/BOOT/BOOTX64.EFI"
fi

say "checking signatures"
if sbctl verify 2>&1 | grep -q 'is not signed'; then
  sbctl verify >&2 || true
  die "some boot files are unsigned; Secure Boot would refuse them. No keys were enrolled; fix this and run the command again"
fi
sbctl verify

if ((setup_mode)); then
  say "enrolling the keys with Microsoft's"
  sbctl enroll-keys --microsoft
else
  say "the firmware is not in setup mode: keys are already enrolled"
  echo "   If they are not this machine's sbctl keys, reset the firmware to setup mode and run this again."
fi

cat <<'EOF'

Secure Boot keys are enrolled and every boot file is signed.
Reboot. If the firmware does not switch Secure Boot on by itself, turn it
on in the firmware settings. `subcult secureboot status` checks it after.
EOF
