pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "ManifestModel.js" as ManifestModel

// The widgets the shell knows, read from widgets/index.json (generated by
// tools/shell/gen-index.py). A manifest that fails the v0 rules is skipped
// with a warning, so one bad widget never stops the bar.
Singleton {
  id: root

  readonly property int api: 0
  property var widgets: ({})

  function entry(id) {
    return widgets[id] || null
  }

  FileView {
    path: Quickshell.shellDir + "/widgets/index.json"
    blockLoading: true
    onLoaded: {
      let index = {}
      try {
        index = JSON.parse(text())
      } catch (e) {
        console.warn("subcult shell: widgets/index.json is broken:", e.message)
        return
      }
      const ok = {}
      for (const id in index.widgets || {}) {
        const errors = ManifestModel.validate(index.widgets[id].manifest, root.api)
        if (errors.length > 0)
          console.warn("subcult shell: skipping", id + ":", errors.join("; "))
        else
          ok[id] = index.widgets[id]
      }
      root.widgets = ok
    }
  }
}
