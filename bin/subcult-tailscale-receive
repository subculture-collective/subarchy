#!/usr/bin/env bash
# subcult:summary=Save files sent to this machine with Taildrop to Downloads
# subcult:args=[--once] [directory]
# subcult:examples=subcult tailscale receive --once | subcult tailscale receive ~/Desktop
#
# ADR 0058. The user unit subcult-tailscale-receive.service runs this for
# the session. `tailscale file get --wait` sleeps until files arrive, then
# they are moved into Downloads (a taken name gets -1, -2 ...) and each is
# announced. Taildrop needs a signed-in tailscaled and this user as its
# operator; until then this waits five minutes between tries, and the bar's
# Tailscale panel restarts the unit when it sees the sign-in.
set -euo pipefail

once=0
if [[ ${1:-} == --once ]]; then
  once=1
  shift
fi
dir=${1:-${XDG_DOWNLOAD_DIR:-$HOME/Downloads}}
# Files land in a staging folder next to the destination first; same
# filesystem, so the move is a rename. `tailscale file get` writes each file
# under its final name and then drops it from tailscaled's inbox, so a run
# stopped halfway leaves a cut-off file. Each get therefore writes into its
# own get.* folder, renamed to done.* only once the get has succeeded. A
# get.* folder found later is thrown away: its files are still in the inbox
# and come again.
staging=$dir/.taildrop
retry=${SUBCULT_TAILDROP_RETRY:-300}

# claim FILE: hard-link the staged file to a free name in $dir, then drop
# the staged name. link(2) fails on a taken name, so nothing is overwritten
# even when another program writes to Downloads at the same time. Prints
# the path it took.
claim() {
  local staged=$1 name base ext target i
  name=${staged##*/}
  base=${name%.*}
  ext=${name:${#base}}
  [[ -n $base ]] || { base=$name ext=; }
  for ((i = 0; i < 1000; i++)); do
    target=$dir/$name
    ((i == 0)) || target=$dir/$base-$i$ext
    if ln -- "$staged" "$target" 2>/dev/null; then
      rm -f -- "$staged"
      printf '%s\n' "$target"
      return 0
    fi
    [[ -e $target ]] || return 1
  done
  return 1
}

announce() {
  local path=$1 shown
  shown=${dir/#"$HOME"/"~"}
  notify-send -a Taildrop -i folder-download -- "Received ${path##*/}" "Saved to $shown" || true
}

# Moves the files of every finished get into $dir and announces them. A
# file that cannot be placed stays for the next round.
deliver() {
  local batch staged target
  for batch in "$staging"/done.*; do
    [[ -d $batch ]] || continue
    while IFS= read -r -d '' staged; do
      target=$(claim "$staged") || continue
      announce "$target"
    done < <(find "$batch" -mindepth 1 -maxdepth 1 -type f -print0)
    rmdir -- "$batch" 2>/dev/null || true
  done
}

# Finished gets a stopped run did not deliver come first; unfinished ones go.
mkdir -p "$staging"
rm -rf -- "$staging"/get.*
deliver
last=
while true; do
  # Made again each round: Downloads may have been removed meanwhile.
  mkdir -p "$staging"
  get=$(mktemp -d "$staging/get.XXXXXX")
  if err=$(tailscale file get --wait --conflict=rename "$get" 2>&1 >/dev/null); then
    mv -- "$get" "$staging/done.${get##*/get.}"
    last=
    deliver
    ((once)) && exit 0
    continue
  fi
  rm -rf -- "$get"
  # The same refusal every few minutes (signed out) is logged once.
  [[ $err == "$last" ]] || echo "subcult tailscale receive: $err" >&2
  last=$err
  ((once)) && exit 1
  sleep "$retry" &
  wait $!
done
