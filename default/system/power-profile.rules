# Subarchy (ADR 0021): pick the power profile when the power source changes.
# Installed to /usr/lib/udev/rules.d/90-subarchy-power.rules.
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", RUN+="/usr/bin/systemd-run --no-block --collect --unit=subcult-power-auto-udev --property=After=power-profiles-daemon.service /usr/bin/subcult-power-auto"
SUBSYSTEM=="power_supply", ATTR{type}=="USB", RUN+="/usr/bin/systemd-run --no-block --collect --unit=subcult-power-auto-udev --property=After=power-profiles-daemon.service /usr/bin/subcult-power-auto"
