[Unit]
Description=Save files sent with Taildrop to Downloads (subcult tailscale receive)
Documentation=https://git.subcult.tv/subculture-collective/subarchy
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Not for system users: the greeter runs a compositor as sddm.
ConditionUser=!@system
ConditionPathExists=/usr/bin/tailscale

[Service]
Type=exec
# `tailscale file get --wait` sleeps until files arrive; signed out it
# retries every five minutes, and the bar's Tailscale panel restarts this
# unit when it sees the sign-in (ADR 0054, ADR 0058).
ExecStart=/usr/bin/subcult-tailscale-receive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
