# shellcheck shell=bash
# Subarchy's bash setup (ADR 0041). The user's ~/.bashrc sources this file
# and holds the user's own lines after it. zsh is the login shell; this
# keeps bash, for those who switch, on the same aliases and tools.
[[ $- == *i* ]] || return 0

# This file's folder, so a test can run a copy from the source tree.
_subcult_shell=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize

export EDITOR=${EDITOR:-nvim}
export SUDO_EDITOR=${SUDO_EDITOR:-$EDITOR}
if command -v bat >/dev/null; then
  export BAT_THEME=${BAT_THEME:-ansi}
  export MANROFFOPT=-c
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# shellcheck source=/dev/null
source "$_subcult_shell/functions.sh"
# shellcheck source=/dev/null
source "$_subcult_shell/aliases.sh"

# Tools, each only when installed. Only fzf's key bindings: its completion
# file rewraps many commands' completions at every start.
command -v mise >/dev/null && eval "$(mise activate bash)"
# shellcheck source=/dev/null
[[ -r /usr/share/fzf/key-bindings.bash ]] && source /usr/share/fzf/key-bindings.bash
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
if command -v starship >/dev/null && [[ ${TERM:-} != dumb ]]; then
  if [[ -z ${STARSHIP_CONFIG:-} && ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml ]]; then
    export STARSHIP_CONFIG=$_subcult_shell/starship.toml
  fi
  eval "$(starship init bash)"
fi
unset _subcult_shell
