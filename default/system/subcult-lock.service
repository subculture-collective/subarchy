[Unit]
Description=Subarchy lock screen (ADR 0036)
Documentation=file:///usr/share/subcult/lock
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/quickshell -n -p /usr/share/subcult/lock
Environment=QS_NO_RELOAD_POPUP=1
Environment=QS_DISABLE_FILE_WATCHER=1
Environment=QS_DISABLE_CRASH_HANDLER=1
# The program exits on its own once unlocked. If it dies while locked the
# compositor keeps the session locked and draws its own notice; the
# replacement started here takes the lock over, which Hyprland allows
# because the defaults set misc:allow_session_lock_restore (ADR 0070).
Restart=on-failure
RestartSec=1
