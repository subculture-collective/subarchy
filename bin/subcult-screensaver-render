#!/usr/bin/env python3
# subcult:summary=Render the screensaver loops from the recorded effects in the palette
# subcult:args=[--user] [--out DIR] [--palette FILE] [--captures DIR] [--size WxH] [--fps N] [--force]
# subcult:examples=subcult screensaver render --user | subcult screensaver render --out build/screensaver --palette default/theme/palette.json
"""Renders the SUBCULT screensaver loops (ADR 0036): each recorded ttfx
effect (a `script` capture with timings, gzipped, under the captures
directory) is replayed through pyte, a terminal emulator, drawn one frame
at a time with Pillow in the palette's colours, and encoded by ffmpeg to a
VP9 WebM loop; the last frame is kept as a PNG for the still art on
battery. index.json lists what was rendered. Outputs with unchanged inputs
are left alone, so a run after nothing changed does nothing.

The package renders the default palette at build time into
/usr/share/subcult/screensaver; `--user` renders the user's palette
(~/.config/subcult/theme/palette.json, what Pult writes) into
~/.cache/subcult/screensaver, which the lock program prefers. Needs
python-pyte, python-pillow and ffmpeg. The effect never runs on the locked
machine: these loops are what the lock plays.
"""
import argparse
import fcntl
import gzip
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile

import pyte
from PIL import Image, ImageDraw, ImageFont

FONTS = ["/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf", "/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf",
         "/usr/share/fonts/TTF/DejaVuSansMono.ttf"]
# pyte's colour names to palette roles, with subcult-minimal as the fallback.
ANSI = {"black": 0, "red": 1, "green": 2, "brown": 3, "yellow": 3, "blue": 4, "magenta": 5, "cyan": 6, "white": 7,
        "brightblack": 8, "brightred": 9, "brightgreen": 10, "brightbrown": 11, "brightyellow": 11, "brightblue": 12,
        "brightmagenta": 13, "brightcyan": 14, "brightwhite": 15}
FALLBACK = {"lavender": "#a78bfa", "base": "#100b19", "text": "#f0ece4", "ansi0": "#06040a", "ansi1": "#d52032", "ansi2": "#00ff88", "ansi3": "#f6d447",
            "ansi4": "#7799ff", "ansi5": "#8b5cf6", "ansi6": "#4fd6c8", "ansi7": "#f0ece4", "ansi8": "#5e5570", "ansi9": "#ff4055",
            "ansi10": "#00ff88", "ansi11": "#f6d447", "ansi12": "#a78bfa", "ansi13": "#c4b5fd", "ansi14": "#75f2e4", "ansi15": "#f0ece4"}


def read_palette(path):
    try:
        with open(path) as f:
            doc = json.load(f)
        colors = doc.get("colors", {}) if isinstance(doc, dict) else {}
        if not isinstance(colors, dict):
            colors = {}
    except (OSError, ValueError):
        colors = {}
    out = dict(FALLBACK)
    for role, c in colors.items():
        if isinstance(c, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", c):
            out[role] = c.lower()
    return out


def open_capture(path):
    return gzip.open(path, "rb") if path.endswith(".gz") else open(path, "rb")


def render(name, log, timing, out, palette, size, fps, font):
    """One effect streamed to ffmpeg; the still is the last frame."""
    cols, rows = 96, 27
    width, height = size
    cell_w, cell_h = width // cols, height // rows
    with open_capture(log) as f:
        data = f.read()
    data = data[data.index(b"\n") + 1:]  # script's header line
    with open_capture(timing) as f:
        chunks = [(float(a), int(b)) for a, b in (line.split() for line in f.read().decode().splitlines() if line.strip())]
    screen = pyte.Screen(cols, rows)
    stream = pyte.ByteStream(screen)
    ink, paper = palette["base"], palette["text"]

    def colour(c):
        if c == "default":
            return paper
        if c in ANSI:
            return palette.get("ansi%d" % ANSI[c], paper)
        if len(c) == 6:
            # ttfx uses truecolour gradients. Preserve their brightness,
            # tinted with the theme's lavender rather than its recorded hue.
            level = max(int(c[i:i + 2], 16) for i in (0, 2, 4)) / 255
            tint = palette["lavender"]
            return "#" + "".join("%02x" % int(int(tint[i:i + 2], 16) * level) for i in (1, 3, 5))
        return paper

    # Stream raw frames to ffmpeg: no uncompressed video on disk.
    with tempfile.TemporaryDirectory(prefix=".render-", dir=out) as work:
        command = ["ffmpeg", "-loglevel", "error", "-y", "-f", "rawvideo", "-pixel_format", "rgb24",
                   "-video_size", "%dx%d" % size, "-framerate", str(fps), "-i", "-", "-an",
                   "-c:v", "libvpx-vp9", "-threads", "2", "-b:v", "0", "-crf", "34", "-pix_fmt", "yuv420p",
                   os.path.join(work, name + ".webm")]
        encoder = subprocess.Popen(command, stdin=subprocess.PIPE)
        try:
            def draw():
                img = Image.new("RGB", (cols * cell_w, rows * cell_h), ink)
                d = ImageDraw.Draw(img)
                for y in range(rows):
                    for x in range(cols):
                        ch = screen.buffer[y][x]
                        if ch.data.strip():
                            d.text((x * cell_w, y * cell_h), ch.data, fill=colour(ch.fg), font=font)
                return img.resize(size) if img.size != size else img

            pos, t, frame, next_t = 0, 0.0, 0, 0.0
            for delay, size_ in chunks:
                t += delay
                while next_t <= t:
                    encoder.stdin.write(draw().tobytes())
                    frame += 1
                    next_t += 1 / fps
                stream.feed(data[pos:pos + size_])
                pos += size_
            last = draw()
            encoder.stdin.write(last.tobytes())
            encoder.stdin.close()
            if encoder.wait() != 0:
                raise RuntimeError("ffmpeg failed for " + name)
            last.save(os.path.join(work, name + ".png"))
            for ext in (".webm", ".png"):
                os.replace(os.path.join(work, name + ext), os.path.join(out, name + ext))
            return frame + 1, t
        finally:
            if encoder.poll() is None:
                encoder.kill()
            encoder.wait()


def main():
    ap = argparse.ArgumentParser(description="Render the screensaver loops in the palette")
    ap.add_argument("--user", action="store_true", help="the user's palette into ~/.cache/subcult/screensaver")
    ap.add_argument("--out", help="output directory")
    ap.add_argument("--palette", help="palette file (Pult's format)")
    ap.add_argument("--captures", help="directory of <name>.log.gz and <name>.tm.gz")
    ap.add_argument("--size", default="960x540", help="loop size, WxH")
    ap.add_argument("--fps", type=int, default=30)
    ap.add_argument("--force", action="store_true", help="render even when the outputs are newer")
    a = ap.parse_args()
    system = os.environ.get("SUBCULT_PATH", "/usr/share/subcult")
    xdg_config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ.get("HOME", "/"), ".config")
    xdg_cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.environ.get("HOME", "/"), ".cache")
    captures = a.captures or os.path.join(system, "screensaver/captures")
    if a.user:
        out = a.out or os.path.join(xdg_cache, "subcult/screensaver")
        palette_path = a.palette or os.path.join(xdg_config, "subcult/theme/palette.json")
        if not os.path.exists(palette_path):
            palette_path = os.path.join(system, "default/theme/palette.json")
    else:
        if not a.out or not a.palette:
            print("subcult screensaver render: --out and --palette, or --user", file=sys.stderr)
            return 2
        out, palette_path = a.out, a.palette
    try:
        width, height = (int(v) for v in a.size.lower().split("x"))
        if width < 192 or height < 54 or width % 2 or height % 2 or not 1 <= a.fps <= 60:
            raise ValueError()
    except ValueError:
        ap.error("--size needs even dimensions of at least 192x54; --fps must be 1..60")
    names = sorted(f[:-len(".log.gz")] for f in os.listdir(captures) if f.endswith(".log.gz"))
    if not names:
        print("subcult screensaver render: no captures in " + captures, file=sys.stderr)
        return 1
    os.makedirs(out, exist_ok=True)
    # The path unit coalesces writes; flock also serialises manual renders.
    with open(os.path.join(out, ".render.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return render_all(a, names, captures, out, palette_path, width, height)


def render_all(a, names, captures, out, palette_path, width, height):
    palette = read_palette(palette_path)
    font = None
    for path in FONTS:
        if os.path.exists(path):
            font = ImageFont.truetype(path, int((height // 27) * 0.85))
            break
    if font is None:
        font = ImageFont.load_default()
    inputs = [__file__, palette_path] + [os.path.join(captures, n + ext) for n in names for ext in (".log.gz", ".tm.gz")]
    digest = hashlib.sha256(json.dumps([palette, width, height, a.fps], sort_keys=True).encode())
    for path in inputs:
        with open(path, "rb") as f:
            digest.update(f.read())
    fingerprint = digest.hexdigest()
    index = os.path.join(out, "index.json")
    try:
        with open(index) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    if not a.force and old.get("fingerprint") == fingerprint and all(
            os.path.isfile(os.path.join(out, n + ext)) for n in names for ext in (".webm", ".png")):
        print("screensaver: up to date")
        return 0
    rendered = []
    for name in names:
        log = os.path.join(captures, name + ".log.gz")
        timing = os.path.join(captures, name + ".tm.gz")
        frames, seconds = render(name, log, timing, out, palette, (width, height), a.fps, font)
        print("%s: %d frames, %.1f s, %dx%d" % (name, frames, seconds, width, height))
        rendered.append(name)
    with open(index + ".tmp", "w") as f:
        json.dump({"schema": 1, "palette": os.path.basename(palette_path), "size": [width, height], "loops": rendered, "fingerprint": fingerprint}, f)
        f.write("\n")
    os.replace(index + ".tmp", index)
    return 0


if __name__ == "__main__":
    sys.exit(main())
