# Maintainer: SUBCULT <info@subcult.tv>
# linecast, the terminal almanac the weather widget calls for forecast,
# sun, moon and tides (shell and look design, Ownership; issue #78). Built
# from the upstream tag; bump pkgver and sha256sums together.
#
# Licence: MIT, checked at v2.12.0 (LICENSE: "Copyright (c) 2025 Andrew
# Shuttleworth"); pyproject.toml declares license = "MIT". Installed to
# /usr/share/licenses/linecast/LICENSE.
pkgname=linecast
pkgver=2.12.0
pkgrel=1
pkgdesc="Weather, tides, the sun, the moon and maps, drawn for the terminal"
arch=('any')
url="https://github.com/ashuttl/linecast"
license=('MIT')
depends=('python' 'tzdata')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b780ec5774e8adeb7f0d598c10f7c70b4d9ad22095d3066d58dc2d53ebed9351')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
