#!/usr/bin/env bash
# subcult:summary=Run one app on the NVIDIA GPU (PRIME render offload)
# subcult:args=<command> [args...]
# subcult:examples=subcult gpu run steam | subcult gpu run mpv --hwdec=nvdec video.mp4
#
# ADR 0006, from the owner's ~/.local/bin/gpu-run on sputnik. In Intel mode
# the session pins EGL and Vulkan to the integrated GPU, so those pins are
# dropped for this app.
set -euo pipefail

if (($# == 0)); then
  echo "Usage: subcult gpu run <command> [args...]" >&2
  exit 2
fi

unset __EGL_VENDOR_LIBRARY_FILENAMES VK_DRIVER_FILES
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
