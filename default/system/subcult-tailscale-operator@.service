[Unit]
Description=Let %I control Tailscale without sudo (ADR 0058)
Documentation=https://git.subcult.tv/subculture-collective/subarchy
# tailscale set needs the running daemon, so the installer cannot do it in
# the chroot; it enables this for the account it makes, and it runs once.
# The marker keeps a later choice (another operator, or none) in place.
# Requisite, not Requires: when the user has turned tailscaled off, this
# must not start it at every boot.
After=tailscaled.service
Requisite=tailscaled.service
ConditionPathExists=/usr/bin/tailscale
ConditionPathExists=!/var/lib/subcult/tailscale-operator-%i

[Service]
Type=oneshot
ExecStart=/usr/bin/tailscale set --operator=%I
ExecStartPost=/usr/bin/install -D -m 0644 /dev/null /var/lib/subcult/tailscale-operator-%i

[Install]
WantedBy=multi-user.target
