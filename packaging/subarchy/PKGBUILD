# Maintainer: SUBCULT <info@subcult.tv>
#
# Builds the core Subarchy package from this source checkout (two levels
# above this file), so CI and local builds test exactly what is committed.
# Release builds will switch to a tagged source archive.

pkgname=subarchy
pkgver=0.0.0
pkgrel=1
pkgdesc="Subarchy: SUBCULT's Arch Linux desktop (subcult CLI, defaults and OS identity)"
arch=('x86_64')
url="https://git.subcult.tv/subculture-collective/subarchy"
license=('GPL-3.0-or-later')
depends=('bash' 'glibc' 'pacman-contrib' 'fakeroot' 'hypridle' 'python-pyte' 'python-pillow' 'ffmpeg' 'qt6-multimedia' 'power-profiles-daemon' 'python-gobject' 'adw-gtk-theme')
makedepends=('go' 'git' 'librsvg' 'imagemagick' 'xorg-xcursorgen' 'hyprcursor' 'ttf-dejavu')
optdepends=('fprintd: fingerprint unlock on the lock screen (subcult setup fingerprint)')
options=('!debug')
backup=(etc/xdg/gtk-3.0/settings.ini etc/xdg/gtk-4.0/settings.ini etc/xdg/kdeglobals etc/chromium/policies/managed/color.json etc/xdg/kitty/kitty.conf etc/xdg/kitty/subcult-ink.conf etc/pam.d/subcult-lock etc/pam.d/subcult-lock-fingerprint)

_root() {
  realpath "$startdir/../.."
}

build() {
  local root
  root=$(_root)
  cd "$root"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly"
  mkdir -p "$srcdir/bin"
  go build -ldflags "-X git.subcult.tv/subculture-collective/subarchy/internal/dispatch.Version=${pkgver}" \
    -o "$srcdir/bin/" ./cmd/...
  # The default cursor, lavender (shell and look design, "Cursor").
  "$srcdir/bin/subcult-cursor" build --role lavender --palette "$root/default/theme/palette.json" \
    --src "$root/default/cursor" --out "$srcdir/subcult-cursor"
  # The boot splash's images (ADR 0013): the SUBCULT mark and the small
  # parts, rendered from their SVG sources.
  mkdir -p "$srcdir/plymouth"
  rsvg-convert -w 240 -o "$srcdir/plymouth/logo.png" "$root/branding/marks/mark-dark.svg"
  for f in bullet entry lock progress-bar progress-box; do
    rsvg-convert -o "$srcdir/plymouth/$f.png" "$root/default/plymouth/$f.svg"
  done
  # The master lockup for the greeter and lock, rendered by librsvg (Qt SVG
  # omits its nested image) with its ink centred on the canvas.
  tools/branding/lockup-png.sh 2000 "$srcdir/lockup-dark.png"
  python3 bin/subcult-screensaver-render --out "$srcdir/screensaver" \
    --palette default/theme/palette.json --captures branding/screensaver
}

check() {
  local root
  root=$(_root)
  cd "$root"
  go test -count=1 ./...
  python3 tools/screensaver/test_render.py
}

package() {
  local root f
  root=$(_root)

  # Compiled commands (subcult, subcult-*, subarchy-setup), then scripts.
  for f in "$srcdir"/bin/*; do
    install -Dm755 "$f" "$pkgdir/usr/bin/$(basename "$f")"
  done
  ln -s subcult "$pkgdir/usr/bin/sub"
  # The Gitea client under its long-standing name: Arch's gitea-cli installs
  # the command as gt, and notes, scripts and agents call tea. A link, not a
  # shell alias, so it works outside an interactive shell too. gitea-cli
  # comes from install/packages/cli.txt.
  ln -s gt "$pkgdir/usr/bin/tea"

  for f in "$root"/bin/subcult-*; do
    [[ -e $f ]] || continue
    install -Dm755 "$f" "$pkgdir/usr/bin/$(basename "$f")"
  done
  install -Dm755 "$root/tools/bluetooth/pair-agent.py" "$pkgdir/usr/lib/subcult/bluetooth-pair-agent"

  # OS identity (ADR 0052). /etc/os-release takes precedence over the
  # filesystem package's /usr/lib/os-release.
  sed "s/@VERSION@/${pkgver}/" "$root/branding/os-release.in" |
    install -Dm644 /dev/stdin "$pkgdir/etc/os-release"

  # System defaults (ADR 0048): app catalogue, Hyprland and SDDM defaults.
  (
    cd "$root/default"
    find . -type f ! -name README.md -print0 |
      while IFS= read -r -d '' f; do
        install -Dm644 "$f" "$pkgdir/usr/share/subcult/default/${f#./}"
      done
  )
  # Session and greeter (ADR 0030, 0031).
  install -Dm644 "$root/default/sddm/subarchy.desktop" "$pkgdir/usr/share/wayland-sessions/subarchy.desktop"
  install -Dm644 "$root/default/sddm/subarchy.conf" "$pkgdir/usr/lib/sddm/sddm.conf.d/subarchy.conf"
  # The greeter theme (ADR 0030) with the SUBCULT lockup, and the boot splash
  # theme (ADR 0013) with its rendered images.
  for f in "$root"/default/sddm/theme/*; do
    install -Dm644 "$f" "$pkgdir/usr/share/sddm/themes/subarchy/$(basename "$f")"
  done
  install -Dm644 "$srcdir/lockup-dark.png" "$pkgdir/usr/share/sddm/themes/subarchy/lockup-dark.png"
  install -Dm644 "$root/default/plymouth/subarchy.plymouth" "$pkgdir/usr/share/plymouth/themes/subarchy/subarchy.plymouth"
  install -Dm644 "$root/default/plymouth/subarchy.script" "$pkgdir/usr/share/plymouth/themes/subarchy/subarchy.script"
  for f in "$srcdir"/plymouth/*.png; do
    install -Dm644 "$f" "$pkgdir/usr/share/plymouth/themes/subarchy/$(basename "$f")"
  done
  # System drop-ins (ADR 0016, 0020, 0063); /etc overrides each of them.
  local sys="$root/default/system"
  install -Dm644 "$sys/sysctl-hardening.conf" "$pkgdir/usr/lib/sysctl.d/90-subarchy-hardening.conf"
  install -Dm644 "$sys/resolved-dns.conf" "$pkgdir/usr/lib/systemd/resolved.conf.d/50-subarchy.conf"
  install -Dm644 "$sys/networkmanager-dns.conf" "$pkgdir/usr/lib/NetworkManager/conf.d/50-subarchy-dns.conf"
  install -Dm644 "$sys/coredump.conf" "$pkgdir/usr/lib/systemd/coredump.conf.d/50-subarchy.conf"
  install -Dm644 "$sys/logind-power-key.conf" "$pkgdir/usr/lib/systemd/logind.conf.d/50-subarchy-power-key.conf"
  # Daily update check (ADR 0026) and power profile by power source (ADR 0021).
  # subcult theme apply-system becomes root through polkit (ADR 0037, 0062).
  install -Dm644 "$root/default/polkit/tv.subcult.theme.policy" "$pkgdir/usr/share/polkit-1/actions/tv.subcult.theme.policy"
  install -Dm644 "$sys/subcult-update-check.service" "$pkgdir/usr/lib/systemd/user/subcult-update-check.service"
  install -Dm644 "$sys/subcult-update-check.timer" "$pkgdir/usr/lib/systemd/user/subcult-update-check.timer"
  install -dm755 "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../subcult-update-check.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/subcult-update-check.timer"
  # Calendar sync (ADR 0061); the command exits at once without a config.
  install -Dm644 "$sys/subcult-calendar-sync.service" "$pkgdir/usr/lib/systemd/user/subcult-calendar-sync.service"
  install -Dm644 "$sys/subcult-calendar-sync.timer" "$pkgdir/usr/lib/systemd/user/subcult-calendar-sync.timer"
  ln -s ../subcult-calendar-sync.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/subcult-calendar-sync.timer"
  install -Dm644 "$sys/power-profile.rules" "$pkgdir/usr/lib/udev/rules.d/90-subarchy-power.rules"
  install -Dm644 "$sys/subcult-power-auto.service" "$pkgdir/usr/lib/systemd/system/subcult-power-auto.service"
  install -Dm644 "$sys/subcult-ufw-docker.service" "$pkgdir/usr/lib/systemd/system/subcult-ufw-docker.service"
  # Dell firmware power and charging profiles (ADR 0021): the files wheel
  # writes from the bar; the widget itself is enabled by `subcult hw`.
  install -Dm644 "$sys/dell-power.rules" "$pkgdir/usr/lib/udev/rules.d/90-subarchy-dell-power.rules"
  install -Dm644 "$sys/subcult-dell-power-permissions.service" "$pkgdir/usr/lib/systemd/system/subcult-dell-power-permissions.service"
  # GPU modes on hybrid laptops (ADR 0006).
  install -Dm644 "$sys/gpu.rules" "$pkgdir/usr/lib/udev/rules.d/70-subarchy-gpu.rules"
  install -Dm644 "$sys/uwsm-gpu-env" "$pkgdir/usr/share/uwsm/env-hyprland.d/50-subarchy-gpu"

  # Web apps (ADR 0042, app list): Discord's entry and the Vencord Web
  # extension, installed through Chromium's external extension files.
  for f in "$root"/applications/*.desktop; do
    install -Dm644 "$f" "$pkgdir/usr/share/applications/$(basename "$f")"
  done
  for f in "$root"/default/chromium/extensions/*.json; do
    install -Dm644 "$f" "$pkgdir/usr/share/chromium/extensions/$(basename "$f")"
  done
  # Chromium's frame colour for the default theme; `subcult theme
  # apply-system` replaces it with the user's (ADR 0037).
  install -Dm644 "$root/default/chromium/policies/managed/color.json" "$pkgdir/etc/chromium/policies/managed/color.json"

  # Look layer (shell and look design): GTK, kitty and Neovim defaults.
  install -Dm644 "$root/default/gtk/90-subarchy.gschema.override" "$pkgdir/usr/share/glib-2.0/schemas/90-subarchy.gschema.override"
  install -Dm644 "$root/default/gtk/settings.ini" "$pkgdir/etc/xdg/gtk-3.0/settings.ini"
  install -Dm644 "$root/default/gtk/settings.ini" "$pkgdir/etc/xdg/gtk-4.0/settings.ini"
  # KDE apps select Pult's colour scheme; the packaged one stands in until
  # `pult apply` writes the user's (ADR 0037).
  install -Dm644 "$root/default/kde/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
  install -Dm644 "$root/default/kde/Pult.colors" "$pkgdir/usr/share/color-schemes/Pult.colors"
  install -Dm644 "$root/default/kitty/kitty.conf" "$pkgdir/etc/xdg/kitty/kitty.conf"
  install -Dm644 "$root/default/kitty/subcult-ink.conf" "$pkgdir/etc/xdg/kitty/subcult-ink.conf"
  install -Dm644 "$root/default/nvim/colors/subcult-ink.lua" "$pkgdir/usr/share/nvim/site/colors/subcult-ink.lua"
  install -Dm644 "$root/default/nvim/colors/subcult.lua" "$pkgdir/usr/share/nvim/site/colors/subcult.lua"
  install -Dm644 "$root/default/nvim/plugin/subarchy-colors.lua" "$pkgdir/usr/share/nvim/site/plugin/subarchy-colors.lua"

  install -Dm644 "$root/default/fontconfig/44-subarchy-roles.conf" "$pkgdir/usr/share/fontconfig/conf.avail/44-subarchy-roles.conf"
  install -dm755 "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.avail/44-subarchy-roles.conf "$pkgdir/etc/fonts/conf.d/44-subarchy-roles.conf"
  install -dm755 "$pkgdir/usr/share/icons"
  cp -a "$srcdir/subcult-cursor" "$pkgdir/usr/share/icons/subcult-cursor"

  # The desktop shell (shell and look design), started with the session.
  (
    cd "$root/shell"
    find . -type f ! -path '*/tests/*' ! -name README.md -print0 |
      while IFS= read -r -d '' f; do
        install -Dm644 "$f" "$pkgdir/usr/share/subcult/shell/${f#./}"
      done
  )
  install -Dm644 "$sys/subcult-shell.service" "$pkgdir/usr/lib/systemd/user/subcult-shell.service"
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../subcult-shell.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/subcult-shell.service"
  # Monitor layout profiles on dock and undock (rice port); idle until a
  # monitor event arrives.
  install -Dm644 "$sys/subcult-display.service" "$pkgdir/usr/lib/systemd/user/subcult-display.service"
  ln -s ../subcult-display.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/subcult-display.service"
  # The lock screen (ADR 0036): its own program in its own unit, started on
  # demand by hypridle or `subcult lock`; and the idle service that runs
  # hypridle with the config generated from the user's idle settings.
  (
    cd "$root/lock"
    find . -type f ! -path '*/tests/*' ! -name README.md -print0 |
      while IFS= read -r -d '' f; do
        install -Dm644 "$f" "$pkgdir/usr/share/subcult/lock/${f#./}"
      done
  )
  install -Dm644 "$srcdir/lockup-dark.png" "$pkgdir/usr/share/subcult/lock/lockup-dark.png"
  install -Dm644 "$root/default/pam/subcult-lock" "$pkgdir/etc/pam.d/subcult-lock"
  # Fingerprint unlock (#93): a stack of its own beside the password's, run
  # only where fprintd has a finger enrolled for the user.
  install -Dm644 "$root/default/pam/subcult-lock-fingerprint" "$pkgdir/etc/pam.d/subcult-lock-fingerprint"
  install -Dm644 "$sys/subcult-lock.service" "$pkgdir/usr/lib/systemd/user/subcult-lock.service"
  install -Dm644 "$sys/subcult-idle.service" "$pkgdir/usr/lib/systemd/user/subcult-idle.service"
  ln -s ../subcult-idle.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/subcult-idle.service"
  for f in "$root"/branding/screensaver/*.gz; do
    install -Dm644 "$f" "$pkgdir/usr/share/subcult/screensaver/captures/$(basename "$f")"
  done
  for f in "$srcdir"/screensaver/*; do
    install -Dm644 "$f" "$pkgdir/usr/share/subcult/screensaver/$(basename "$f")"
  done
  install -Dm644 "$sys/subcult-screensaver.service" "$pkgdir/usr/lib/systemd/user/subcult-screensaver.service"
  ln -s ../subcult-screensaver.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/subcult-screensaver.service"
  # Clipboard history for the launcher (ADR 0056); wl-paste sleeps between copies.
  install -Dm644 "$sys/subcult-clipboard.service" "$pkgdir/usr/lib/systemd/user/subcult-clipboard.service"
  ln -s ../subcult-clipboard.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/subcult-clipboard.service"

  # Migrations run once per user by `subcult update` (ADR 0026).
  install -dm755 "$pkgdir/usr/share/subcult/migrations"
  for f in "$root"/migrations/*.sh; do
    [[ -e $f ]] || continue
    install -Dm644 "$f" "$pkgdir/usr/share/subcult/migrations/$(basename "$f")"
  done

  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
