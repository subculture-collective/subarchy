filters:
  and:
    - file.inFolder("docs")
    - file.ext == "md"
    - not:
        - file.inFolder("docs/templates")
properties:
  note.title:
    displayName: Title
  note.type:
    displayName: Type
  note.status:
    displayName: Status
  note.review:
    displayName: Review
  note.updated:
    displayName: Updated
views:
  - type: table
    name: Needs review
    filters:
      or:
        - 'note.status == "proposed"'
        - 'note.status == "draft"'
        - 'note.review == "pending"'
    order:
      - file.name
      - note.title
      - note.type
      - note.status
      - note.updated
  - type: table
    name: All notes
    groupBy:
      property: note.type
      direction: ASC
    order:
      - file.name
      - note.title
      - note.status
      - note.updated
