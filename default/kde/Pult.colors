# Subarchy's fallback KDE colour scheme (ADR 0037), installed to
# /usr/share/color-schemes/. The user's ~/.local/share/color-schemes/
# Pult.colors, which `pult apply` writes, takes its place. Rendered from
# SUBCULT Minimal with Pult's template:
#   pult render default/theme/subcult-minimal.json kde/Pult.colors.mustache
# tools/test/palette-test.py checks its main colours against the theme.

[ColorEffects:Disabled]
Color=94,85,112
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
