[Unit]
Description=Sync CalDAV and iCal calendars into the shell's cache (ADR 0061)
Documentation=https://git.subcult.tv/subculture-collective/subarchy
After=network-online.target
# Not for system users: the greeter's sddm user gets a user manager too.
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/bin/subcult-calendar sync
